APP_NAME=Laravel
# SECURE BY DEFAULT — this example ships production-safe values so a
# careless `cp .env.example .env` on a server never enables debug
# traces. For LOCAL development, set APP_ENV=local and APP_DEBUG=true
# in your own .env (which is gitignored).
APP_ENV=production
APP_KEY=
# APP_DEBUG MUST be false in production. true leaks full stack traces
# (file paths, DB structure, Odoo/AI credentials) to any visitor on a 500.
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

# ── Tenant login shared-password fallback (DISABLED by default) ──────
# The legacy "one password logs into any workspace" fallback is OFF.
# Leave it off — real DB users are the supported login path. Only set
# this true (with non-default APP_USER/APP_PASSWORD) if you have a
# specific legacy reason. See config/bi.php + AuthController.
BI_AUTH_FALLBACK_ENABLED=false
# APP_USER=
# APP_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────────────────
#
# Default driver is `log` — emails render into storage/logs/laravel.log
# without being delivered. Useful for local dev; useless in production.
#
# For real delivery in production (e.g. on Hostinger), set MAIL_MAILER=smtp
# and provide SMTP credentials. Common provider settings:
#
#   Hostinger SMTP:
#     MAIL_HOST=smtp.hostinger.com
#     MAIL_PORT=587   (STARTTLS) — or 465 (SSL)
#     MAIL_SCHEME=tls (for 587)  — or ssl (for 465)
#     MAIL_USERNAME=postmaster@yourdomain.com
#     MAIL_PASSWORD=<the SMTP password you created in hPanel → Emails>
#
#   Mailgun / Sendgrid / SES: use their published SMTP relay settings,
#   or install the dedicated transport package and set MAIL_MAILER
#   accordingly (`mailgun`, `ses`, `postmark`, `resend`).
#
# After editing this block on the server:
#   php artisan config:clear
#
# Then verify end-to-end at: /admin/mail-diagnostic
# That page shows the live config + sends a real WelcomeUserMail to any
# address (defaults to your own admin email). A successful round-trip
# proves the welcome-email flow on /admin/users/create works too.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
