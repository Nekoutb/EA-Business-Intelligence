# Copy this file to .env and fill in your Odoo credentials.
# The .env file is git-ignored.

# Odoo server URL (no trailing slash)
ODOO_URL=https://mycompany.odoo.com

# Odoo database name
ODOO_DB=mycompany

# Odoo login (email / username)
ODOO_USERNAME=admin@example.com

# Odoo API key (Preferences -> Account Security -> New API Key).
# Can also be a password, but API key is strongly recommended.
ODOO_API_KEY=your_api_key_here

# Which protocol to use:
#   json2   -> /json/2/<model>/<method>  (Odoo 19+, RECOMMENDED)
#   jsonrpc -> /jsonrpc                   (Odoo 13-19, deprecated in 19, removed in 22)
#   xmlrpc  -> /xmlrpc/2                  (Odoo 13-19, deprecated in 19, removed in 22)
ODOO_PROTOCOL=json2

# Which Odoo model to treat as "revenue":
#   invoice   -> account.move (posted customer invoices)  [default, accounting-accurate]
#   sale      -> sale.order   (confirmed sales orders)
#   pos       -> pos.order    (point-of-sale orders)
REVENUE_SOURCE=invoice

# App login (protects the dashboard). Change these!
APP_USER=admin
APP_PASSWORD=changeme
APP_SECRET=please-change-this-to-a-long-random-string
